# HomeDesigns AI - for recliner color/material swap
# Get your API key from: https://homedesigns.ai/api
# Set to your backend proxy URL that calls the HomeDesigns API
VITE_HOMEDESIGNS_PROXY_URL=

# WhatsApp Business Number (without +)
VITE_WHATSAPP_NUMBER=201000000000

# ============================================
# BACKEND ENVIRONMENT VARIABLES (for API proxy)
# ============================================

# HomeDesigns AI API Key (DO NOT expose in frontend)
# HOMEDESIGNS_API_KEY=your-api-key-here

# Twilio (for WhatsApp webhook - backend only)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
